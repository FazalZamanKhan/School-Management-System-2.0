# Copy this file to backend/.env on the server and fill in real values.
# backend/.env is gitignored and never committed.
#
#   cp backend/.env.production.example backend/.env

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CHANGE-ME
# Public hostname(s) of the unified Services project, comma-separated.
DJANGO_ALLOWED_HOSTS=school.example.com
# Public origin of the same project (needed for a custom domain).
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.com
DJANGO_TIME_ZONE=UTC

# Neon database (same string you got from the Neon console)
# DATABASE_URL takes priority over the individual DB_* variables.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# HTTPS is terminated by nginx; these are safe with the proxy in place.
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1

# Email (optional; defaults to console)
# DJANGO_EMAIL_HOST=smtp.your-provider.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=your-smtp-username
# DJANGO_EMAIL_PASSWORD=your-smtp-password
# DJANGO_EMAIL_USE_TLS=1
